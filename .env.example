EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_EMERGENCY_CONTACT=

# Optional. Defaults to gemini-flash-latest, which always resolves to the current
# Flash model. Pin an exact model (e.g. gemini-3.6-flash) for reproducible demos.
# A retired model name makes the API return HTTP 404.
EXPO_PUBLIC_GEMINI_MODEL=

# --- Automatic SMS escalation (optional) ---
# Address of the WatchAI alert server in ../server. Leave blank to keep the
# manual "open the SMS composer" flow instead.
# On a physical device this must be your computer's LAN address, NOT localhost:
#   EXPO_PUBLIC_ALERT_API_URL=http://192.168.1.20:8787
EXPO_PUBLIC_ALERT_API_URL=

# Must match ALERT_API_TOKEN on the server when the server sets one.
EXPO_PUBLIC_ALERT_API_TOKEN=

# Minimum severity that escalates with no human approval. LOW | MEDIUM | HIGH | CRITICAL
# Defaults to CRITICAL.
EXPO_PUBLIC_AUTO_SMS_MIN_SEVERITY=CRITICAL
